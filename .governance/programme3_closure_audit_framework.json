  "4_repair_rules": {
    "METADATA": "Update YAML front matter with missing fields",
    "OWNERSHIP": "Assign canonical owner from repository authority, never invent",
    "DEPENDENCY": "Add missing depends_on to canonical document only",
    "INTERFACE": "Extend canonical interface document, never duplicate",
    "EVENT": "Extend canonical event catalog or producer/consumer",
    "CONFIGURATION": "Assign owner from configuration registry",
    "SCHEMA": "Extend canonical schema document",
    "STATE_MACHINE": "Extend canonical state machine document",
    "RECOVERY": "Extend canonical recovery playbook",
    "SECURITY": "Extend canonical security contracts",
    "VALIDATION": "Extend canonical validation rules",
    "DUPLICATE_AUTHORITY": "Retain one canonical owner, convert others to references",
    "THIN_STUB": "Deepen only if belongs to active closure, otherwise reference",
    "MISSING_ALGORITHM": "Document in canonical owner document",
    "MISSING_SEQUENCE": "Document in lifecycle or procedure document",
    "MISSING_FAILURE_BEHAVIOUR": "Document in recovery or state machine",
    "MISSING_LIFECYCLE": "Create or extend lifecycle document under canonical owner",
    "MISSING_CONTRACT": "Create contract under canonical owner"
  },
