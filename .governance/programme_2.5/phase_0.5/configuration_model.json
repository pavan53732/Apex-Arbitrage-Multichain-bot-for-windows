[
  {
    "name": "governance.db.path",
    "type": "string",
    "default": ".governance/database/governance.db",
    "owner": "Database",
    "validation": "file_exists",
    "hot_reload": false,
    "restart_required": true,
    "migration_rule": "schema_version",
    "version": "1.0.0",
    "security_classification": "internal"
  },
  {
    "name": "governance.graphs.path",
    "type": "string",
    "default": ".governance/graphs",
    "owner": "Graph Builder",
    "validation": "dir_exists",
    "hot_reload": true,
    "restart_required": false,
    "migration_rule": "none",
    "version": "1.0.0",
    "security_classification": "internal"
  }
]